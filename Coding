import easygui as eg 

characters = {}


def leave():
    #This function allows users to quit the programme
    # while also confirming this is something they chose 
    # instead of an accidental click

    quit = eg.buttonbox("Are you sure you would like to quit?",
                        choices=["Yes","No"], title="Confirmation")
    if quit == "Yes":
        eg.msgbox("Thank you for checking out the programme",
                title = "Leaving programme")
        quit

    if quit =="No":
        eg.msgbox("We are taking you back to the main menu",
                  title="Returning")
        main_menu()


def main_menu():
    # This function directs users to the other functions 
    # that allow them to engage with the code

    option = eg.buttonbox("Which action would you like to perform?",
                 choices=["Add","Delete","Edit","View","Quit"],
                 title="Main Menu")
    if option == "Add":
        add()

    if option == "Quit":
        leave()


     
def add():
    ID = eg.integerbox("Please choose a number for your characters ID")
    characters[ID] = {}

    name = eg.enterbox("What is this characters name?",title="Character Name")
    characters[ID]["name"] = name

    age = eg.integerbox("What is " + name + "'s age?",
                        title="Character Age")
    characters[ID]["age"] = age

    pronouns = eg.buttonbox("What are " + name + "'s pronouns?",
                            title="Character Pronouns",
                          choices=["She/Her","He/Him","They/Them","Other"])
    if pronouns == "Other":
        pronouns = eg.enterbox("Please enter " + name + "'s pronouns"
                               + "\n" + "Input it under the format Xx/Yy",
                               title="Character Pronouns")
        characters[ID]["pronouns"] = pronouns
    else:
        characters[ID]["pronouns"] = pronouns

    extra = eg.buttonbox("Do you want to add any extra information?",
                          choices=["Yes","No"],
                          title="Extra Details?")
    if extra == "No":
        eg.msgbox(characters)

    if extra == "Yes":
        def extra_details():
            extra_things = eg.choicebox("What category would you like" 
                                        + "to add to?",
                                    choices=["Eyes","Hair","Skin","Body",
                                             "Main Menu","Complete"],
                                             title="Extra Details Choice")
    
            if extra_things == "Eyes":
                eye_extra = eg.choicebox("What detail would you like to add?",
                                        choices=["Colour","Heterochromia",
                                                 "Shape","Lashes"],
                                         title="Eye Details")
                
                if eye_extra == "Colour":
                    colour = eg.enterbox("What colour eyes does " + name 
                                         + " have?", title="Eye Colour")
                    characters[ID]["Eye Colour"] = colour
                    extra_details()

                if eye_extra == "Heterochromia":
                    heterochromia_R = eg.enterbox("What colour eye is " + name
                                                  + "'s right eye?",
                                        title="Heterochromia Right Eye")
                    characters[ID]["Right Eye Colour"] = heterochromia_R
                    heterochromia_L = eg.enterbox("What colour eye is " + name 
                                                  + "'s left eye?",
                                        title="Heterochromia Left Eye")
                    characters[ID]["Left Eye Colour"] = heterochromia_L
                    extra_details()

                if eye_extra == "Shape":
                    eye_shape = eg.choicebox("What shape eyes does " 
                                            + name + " have?",
                                            choices=["Almond",
                                                    "Round",
                                                    "Hooded",
                                                    "Upturned",
                                                    "Monolid",
                                                    "Downturned",
                                                    "Close-Set",
                                                    "Wide-Set"],
                                                    title="Eye Shape")
                    characters[ID]["Eye Shape"] = eye_shape
                    extra_details()

                if eye_extra == "Lashes":
                    lashes = eg.choicebox("What type of lashes do " + name + 
                                          " have?",choices=["None",
                                                            "Short",
                                                            "Medium",
                                                            "Long"],
                                                            title="Lashes")
                    characters[ID]["Eyelashes"] = lashes
                    extra_details()

            if extra_things == "Hair":
                hair_extra = eg.choicebox("What detail would you like to add?",
                                        choices=["Colour","Dyed","Length",
                                                 "Type","Style"],
                                                 title="Hair Details")
                if hair_extra == "Colour":
                    colour = eg.enterbox("What colour hair does " + name 
                                         + " have?",
                                         title="Hair Colour")
                    characters[ID]["Hair Colour"] = colour
                    extra_details()

                if hair_extra == "Dyed":
                    colour = eg.enterbox("What base colour hair does " + name 
                                        + " have?",
                                        title="Base Hair Colour")
                    characters[ID]["Hair Colour"] = colour
                    dye = eg.enterbox("What dye colour does " + name 
                                        + " have?",
                                        title="Dye Colour")
                    characters[ID]["Dye Colour"] = dye
                    extra_details()
                    # need to make sure it can cycle through instead of such repititve code
                if hair_extra == "Length":
                    length = eg.choicebox("What length hair does " + name + 
                                          " have?",
                                        choices=["No Hair",
                                                "Buzzed",
                                                "Short",
                                                "Shouler Length",
                                                "Over Shoulder",
                                                "Past Ribs",
                                                "Past Tailbone"],
                                                title="Hair Length")
                    characters[ID]["Hair Length"] = length
                    extra_details()
                if hair_extra == "Type":
                    type = eg.choicebox("What type of hair does " + name 
                                        + " have?",
                                        choices=["Naturally Straight",
                                                "Straight",
                                                "Wavy",
                                                "Naturually Curly",
                                                "Perm"],
                                                title="Hair Type")
                    characters[ID]["Hair Type"] = type
                    extra_details()
                if hair_extra == "Style":
                    style = eg.enterbox("What hairstyle does " + name 
                                        + " have?",
                                        title="Hair Style")
                    style_conf = eg.buttonbox("Is " + style + " correct?",
                                        choices=["Yes","No"],
                                        title="Style Confirmation")
                    while style_conf == "No":
                        style = eg.enterbox("What hairstyle does " + name 
                                            + " have?",
                                            title="Hair Style")
                        style_conf = eg.buttonbox("Is " + style + " correct?",
                                                choices=["Yes","No"],
                                                title="Style Confirmation")
                        characters[ID]["Hair Style"] = style
                        extra_details()
                    if style_conf == "Yes":
                        characters[ID]["Hair Style"] = style
                        extra_details()

            if extra_things == "Skin":
                skin_extra = eg.choicebox("What detail would you like to add?",
                                        choices= ["Colour","Details",
                                                  "Conditions"],
                                                  title="Skin Details")
                if skin_extra == "Colour":
                    colour = eg.enterbox("What colour is " + name + "'s skin?",
                                         title="Skin Colour")
                    characters[ID]["Skin Colour"] = colour
                
                if skin_extra == "Details":
                    skin_details = eg.choicebox("What skin detail would" +
                                           "you like to add?",
                                           choices=["Freckles","Moles","Scars"],
                                           title="Specific Skin Details")
                    if skin_details == "Freckles":
                        freckles = eg.choicebox("Where are" + name + 
                                                "'s freckles?",
                                                choices=["Everywhere",
                                                         "Face",
                                                         "Arms","Legs",
                                                         "Upper Body",
                                                         "Lower Body"],
                                                         title="Freckles")
                        characters[ID]["Freckles"] = freckles

                    if skin_details == "Moles":
                        moles = eg.choicebox("Where are" + name + 
                                            "'s moles?",
                                            choices=["Everywhere",
                                                    "Face",
                                                    "Arms","Legs",
                                                    "Upper Body",
                                                    "Lower Body"],
                                                    title="Moles")
                        characters[ID]["Moles"] = moles

                    if skin_details == "Scars":
                        scars = eg.msgbox("Placeholder")
                
            if extra_things == "Body":
                body_extra = eg.choicebox("What detail would you like to add?",
                                        choices=["Height","Shape","Limbs",
                                                 "Weight"],
                                                 title="Body Details")

            if extra_things == "Main Menu":
                eg.msgbox("We are taking you back to the main menu",
                           title="Returning")
                
            if extra_things == "Complete":
                eg.msgbox(characters)
                main_menu()
            main_menu()
        extra_details()

welcome = eg.buttonbox("Welcome to the OC Maker!" + "\n"
          + "Thoughout this programme you will be able to: " + "\n\n"
          + "- Add Characters" + "\n" 
          + "- Edit Characters" + "\n" 
          + "- Delete Characters" + "\n"
          + "- Display Character Information" + "\n\n"
          + "Would you like to proceed?",
          choices=["Yes","No"],title="Welcome")

if welcome == "Yes":
    # first run through must add character before allowing any other option
    main_menu()
    

if welcome == "No":
    leave()
