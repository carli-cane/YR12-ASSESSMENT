def leave():
    """How to leave the programme."""
    exit = eg.choicebox("Are you sure you would like to quit?",
                        choices=YN_choice,
                        title=titles[3])
    if exit == "Yes":
        eg.msgbox("Thank you for checking out the programme",
                  title="Leaving programme")
        quit()

    if exit == "No":
        eg.msgbox("We are taking you back to the main menu",
                  title="Returning")
        main_menu()

# This is the main point of action that moves users to different functions
def main_menu():
    """Allow users to use the code functions."""
    option = eg.buttonbox("Which action would you like to perform?",
                          choices=["Add", "Delete", "Edit", "View", "Quit"],
                          title=titles[1])
    if option == "Add":
        add()

    if option == "Delete":
        delete()

    if option == "Edit":
        editing()

    if option == "View":
        view()

    if option == "Quit":
        leave()


def add():
    """Add characters / information."""
    # This is the basic and required information
    ID = eg.integerbox("Please choose a number for your characters ID",
                       title=titles[4])
    if ID in characters:
        eg.msgbox("Sorry this ID is already assigned to "
                  + characters[ID]["Name"],
                  title=titles[5])

        ID = eg.integerbox("Please choose a number for your characters ID",
                           title=titles[4])
    characters[ID] = {}

    name = eg.enterbox("What is this characters name?",
                       title=titles[4])
    if name == "":
        name = eg.enterbox("Please enter a valid name",
                           title=titles[4])
        characters[ID]["Name"] = name

    characters[ID]["Name"] = name

    age = eg.integerbox("What is " + name + "'s age?" +
                        "\n The maximum range is 10,000 yrs",
                        title=titles[4],
                        upperbound=10000)
    characters[ID]["Age"] = age

    pronouns = eg.buttonbox("What are " + name + "'s pronouns?",
                            title=titles[4],
                            choices=["She/Her", "He/Him",
                                     "They/Them", "Other"])
    if pronouns == "Other":
        # makes sure that pronouns are entered in the correct format
        pronouns = eg.enterbox("Please enter " + name + "'s pronouns"
                               + "\n" + "Input it under the format Xx/Yy",
                               title=titles[4])
        if " / " not in pronouns or pronouns == "Cancel":
            eg.msgbox("ERROR!",
                      title=titles[5])
            pronouns = eg.enterbox("Please make sure to enter "
                                   + name
                                   + "'s pronouns" + " under the format Xx/Yy",
                                   title=titles[4])
            pronouns_confirm = eg.choicebox("Is " + pronouns + " correct?",
                                            choices=YN_choice,
                                            title=titles[3])
            while pronouns_confirm == "No":
                pronouns = eg.enterbox("Please make sure to enter "
                                       + name
                                       + "'s pronouns"
                                       + " under the format Xx/Yy",
                                       title=titles[4])
                pronouns_confirm = eg.choicebox("Is " + pronouns + " correct?",
                                                choices=YN_choice,
                                                title=titles[3])
            else:
                characters[ID]["Pronouns"] = pronouns

    else:
        characters[ID]["Pronouns"] = pronouns
# Extra is physical details that might be handy for the user to store
    extra = eg.buttonbox("Do you want to add any extra information?",
                         choices=YN_choice,
                         title=titles[3])

    if extra == "Yes":
        num = 0
        number = 0
        extra_confirm = eg.buttonbox("You will now be asked a series of "
                                     + "questions regarding four categories."
                                     + "\n\n\n"
                                     + "Eyes: Colour, Heterochromia, "
                                     + "Shape, Eyelashes \n\n"
                                     + "Hair: Colour, Dye, Length, Type, Style"
                                     + "\n\n"
                                     + "Skin: Race, Details, Conditions \n\n"
                                     + "Body: Height, Shape, Part Amounts, "
                                     + "Different Speicies Details \n\n\n"
                                     + "Would you like to proceed?",
                                     choices=YN_choice,
                                     title=titles[2])

        if extra_confirm == "Yes":
            # loops through each question or detail
            for x in range(len(extra_details)):
                extra_things = eg.buttonbox("Would you like to add "
                                            + extra_details[num] + "?",
                                            choices=["Yes", "No"],
                                            title=titles[2])

                if extra_things == "Yes":
                    thing = eg.enterbox("Please input the information for: "
                                        + extra_details[num] + "\n"
                                        + extra_details_info[number],
                                        title=titles[2])
                    characters[ID][extra_details[num]] = thing
                    extra_things_confirm = eg.buttonbox("Is " + thing
                                                        + " correct?",
                                                        choices=YN_choice,
                                                        title=titles[3])

                    if extra_things_confirm == "No":
                        thing = eg.enterbox("Please input for: "
                                            + extra_details[num] + "\n"
                                            + extra_details_info[number],
                                            title=titles[2])
                        characters[ID][extra_details[num]] = thing

                num += 1
                number += 1
    else:
        eg.msgbox(characters,
                  title=titles[4])
        main_menu()

    eg.msgbox(characters,
              title=titles[4])
    main_menu()


def editing():
    """Edit character information."""
    choice_list = []
    for x in characters:
        choice_list.append(str(x))
    id = eg.buttonbox("Which of your characters would you like to edit?",
                      choices=choice_list,
                      title=titles[0])
    id_confirm = eg.buttonbox("Is " + characters[int(id)]["Name"]
                              + " correct?",
                              choices=YN_choice,
                              title=titles[3])
    if id_confirm == "Yes":
        # This runs when the id entered is the character the user wants to edit
        def edit_details():
            # Runs through details that have been entered from user previously
            edit_list = []
            for x in characters[int(id)]:
                edit_list.append(str(x))
            editor = eg.choicebox("Which detail would you like to edit?",
                                  choices=edit_list,
                                  title=titles[4])

            if editor == editor:
                # Offers change to dictionary item by previous choice from user
                # Shows them what was initially entered
                confirm = eg.buttonbox("Would you like to change the "
                                       + editor + " from "
                                       + str(characters[int(id)][editor])
                                       + " ?",
                                       choices=YN_choice,
                                       title=titles[3])
                if confirm == "Yes":
                    # Changes the previous dictionary item to entered one
                    change = eg.enterbox("What would you like to change "
                                         + str(characters[int(id)][editor])
                                         + " to?",
                                         title=titles[4])
                    confirm_change = eg.buttonbox("Is " + change + " correct?",
                                                  choices=YN_choice,
                                                  title=titles[3])
                    if confirm_change == "Yes":
                        characters[int(id)][editor] = change
                        main_menu()

                    while confirm_change == "No":
                        change = eg.enterbox("What would you like to change "
                                             + characters[int(id)][editor]
                                             + " to?",
                                             title=titles[4])
                        confirm_change = eg.buttonbox("Is " + change
                                                      + " correct?",
                                                      choices=YN_choice,
                                                      title=titles[3])
                        if confirm_change == "Yes":
                            characters[int(id)][editor] = change
                            main_menu()
                if confirm == "No":
                    # This runs if the user does not want to change the detail
                    # From what was previously entered
                    edit_details()

        edit_details()

    while id_confirm == "No":
        id = eg.buttonbox("Which is your characters would you like to edit",
                          choices=choice_list,
                          title=titles[0])

        id_confirm = eg.buttonbox("Is " + characters[int(id)]["Name"]
                                  + " correct?",
                                  choices=YN_choice,
                                  title=titles[3])

    if id_confirm == "Main Menu":
        # Gives them an option to return to main menu if there was a misclick
        eg.msgbox("We are taking you back to the main menu",
                  title="Returning")
        main_menu()


def view():
    """View character information."""
    view_amount = eg.choicebox("Would you like to view one character or all?",
                               choices=["One Character", "All Characters"],
                               title=titles[4])

    if view_amount == "All Characters":
        eg.msgbox(characters)

    if view_amount == "One Character":
        # Runs through all entered IDs to create a list from the dictionary 
        choice_list = []
        for x in characters:
            choice_list.append(str(x))
        id = eg.buttonbox("Which of your characters would you like to view?",
                          choices=choice_list,
                          title=titles[0])
        id_confirm = eg.buttonbox("Is " + characters[int(id)]["Name"]
                                  + " correct?",
                                  choices=YN_choice,
                                  title=titles[3])
        if id_confirm == "Yes":
            # Shows the character selecteds information
            eg.msgbox(characters[int(id)],
                      title=titles[4])

        elif id_confirm == "No":
            id = eg.buttonbox("Which character would you like to view?",
                              choices=choice_list,
                              title=titles[0])

            id_confirm = eg.buttonbox("Is " + characters[int(id)]["Name"]
                                      + " correct?",
                                      choices=YN_choice,
                                      title=titles[3],)

    main_menu()


def delete():
    """Delete characters."""
    # Creates a list of all the characters IDs to choose from
    choice_list = []
    for x in characters:
        choice_list.append(str(x))
    delete = eg.buttonbox("What is the id of the character "
                          + "you want to delete?",
                          choices=choice_list,
                          title="Delete")

    delete_confirm = eg.buttonbox("Is " + characters[int(delete)]["Name"]
                                  + " correct?",
                                  choices=YN_choice,
                                  title=titles[3])
    while delete_confirm == "No":
        delete = eg.choicebox("What is the id of the character "
                              + "you want to delete?",
                              choices=choice_list,
                              title="Delete")

        delete_confirm = eg.buttonbox("Is "
                                      + characters[int(delete)]["Name"]
                                      + " correct?",
                                      choices=YN_choice,
                                      title=titles[3])

    if delete_confirm == "Yes":
        eg.msgbox(characters[int(delete)]["Name"] + " has been deleted",
                  title="Deletion Complete")
        characters.pop(int(delete))
        main_menu()

