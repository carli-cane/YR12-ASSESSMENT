def leave():
    # This function allows users to quit the programme
    # while also confirming this is something they chose 
    # instead of an accidental click

    exit = eg.choicebox("Are you sure you would like to quit?",
                        choices=YN_choice, 
                        title=constant_title[3])
    if exit == "Yes":
        eg.msgbox("Thank you for checking out the programme",
                title = "Leaving programme")
        quit

    if exit =="No":
        eg.msgbox("We are taking you back to the main menu",
                  title="Returning")
        main_menu()


def main_menu():
    # This function directs users to the other functions 
    # that allow them to engage with the code

    option = eg.buttonbox("Which action would you like to perform?",
                choices=["Add","Delete","Edit","View","Quit"],
                title=constant_title[1])
    if option == "Add":
        add()

    if option == "Delete":
        delete()

    if option == "Edit":
        editing()

    if option == "View":
        view()

    if option == "Quit":
        leave()


     
def add():
    ID = eg.integerbox("Please choose a number for your characters ID",
                       title=constant_title[4])
    if ID in characters:
        eg.choicebox("Sorry this ID is already assigned to " 
                    + characters[ID]["name"],
                    title=constant_title[5])
        
        ID = eg.integerbox("Please choose a number for your characters ID",
                       title=constant_title[4])
    characters[ID] = {}

    name = eg.enterbox("What is this characters name?",
                       title=constant_title[4])
    characters[ID]["Name"] = name

    age = eg.integerbox("What is " + name + "'s age?",
                        title=constant_title[4],
                        upperbound=10000)
    characters[ID]["Age"] = age

    pronouns = eg.buttonbox("What are " + name + "'s pronouns?",
                            title=constant_title[4],
                            choices=["She/Her","He/Him","They/Them","Other"])
    if pronouns == "Other":
        pronouns = eg.enterbox("Please enter " + name + "'s pronouns"
                               + "\n" + "Input it under the format Xx/Yy",
                               title=constant_title[4])
        while "/" not in pronouns:
            eg.msgbox("ERROR!",
                    title=constant_title[5])
            pronouns = eg.enterbox("Please make sure to enter " 
                                   + name 
                                   + "'s pronouns" + " under the format Xx/Yy",
                        title=constant_title[4])
        characters[ID]["Pronouns"] = pronouns
    else:
        characters[ID]["Pronouns"] = pronouns

    extra = eg.buttonbox("Do you want to add any extra information?",
                        choices=YN_choice,
                        title=constant_title[2])

    if extra == "Yes":
        num = 0
        number = 0
        extra_confirm = eg.buttonbox("You will now be asked a series of " 
                            + "questions regarding four main categories.\n\n\n"
                            + "Eyes: Colour, Heterochromia, " 
                            + "Shape, Eyelashes \n\n"
                            + "Hair: Colour, Dye, Length, Type, Style \n\n"
                            + "Skin: Colour, Details, Conditions \n\n"
                            + "Body: Height, Shape, Part Amounts, " 
                            + "Different Speicies Details \n\n\n"
                            + "Would you like to proceed?",
                            choices=YN_choice)
    else:
        eg.msgbox(characters,
                  title=constant_title[4])
        main_menu()
        
        if extra_confirm == "Yes":
            for x in range(len(extra_details)):
                extra_things = eg.buttonbox("Would you like to add " 
                                + extra_details[num] + "?",
                                choices=["Yes","No"],
                                title=constant_title[2])
        
                if extra_things == "Yes":
                    thing = eg.enterbox("Please input the information for: " 
                                    + extra_details[num] + "\n"
                                    + extra_details_information[number],
                                    title=constant_title[2])
                    characters[ID][extra_details[num]] = thing
                    extra_things_confirm = eg.buttonbox("Is " + thing 
                                                    + " correct?",
                                                    choices=YN_choice,
                                                    title=constant_title[3])
                    
                    if extra_things_confirm == "No":
                        thing = eg.enterbox("Please input the information for: " 
                                    + extra_details[num] + "\n"
                                    + extra_details_information[number],
                                    title=constant_title[2])
                        characters[ID][extra_details[num]] = thing

                    
                num +=1
                number += 1

    eg.msgbox(characters)
    main_menu()
        

def editing():
        id = eg.integerbox("What is the characters ID you would like to edit?",
                        title=constant_title[0])

        while id not in characters:
            eg.msgbox("That ID does not exist",
                    title=constant_title[5])
            id = eg.integerbox("What is your characters ID?",
                            title=constant_title[0])
            
        else:
            id_confirm = eg.choicebox("Is " + characters[id]["Name"] 
                                    + " correct?",
                                    choices=YN_choice)
            
            while id_confirm == "No":
                id = eg.integerbox("What is the characters ID"
                                + " you would like to edit?",
                                title=constant_title[0])
                id_confirm = eg.choicebox("Is " + characters[id]["Name"] 
                            + " correct?",
                            choices=YN_choice,
                            title=constant_title[3])
                
                while id not in characters:
                        eg.msgbox("That ID does not exist",
                                title=constant_title[5])
                        id = eg.integerbox("What is your characters ID?",
                                        title=constant_title[0])
                else:
                    id_confirm = eg.choicebox("Is " + characters[id]["Name"] 
                                    + " correct?",
                                    title=constant_title[3],
                                    choices=YN_choice)
            
                        
                        

            id_confirm = id

        if id in characters:
            def base_detail_edit():
                edit = eg.choicebox("What base detail would you like to edit?",
                            choices=["Name","Age","Pronouns","Confirm"])
                if edit == "Name":
                    name_edit = eg.enterbox(characters[id]["Name"] 
                                    + " is the current name." 
                                    + "\n" 
                                    + "What would you like the new name to be?",
                                    title=constant_title[4])
                    characters[id]["Name"] = name_edit
                    base_detail_edit()

                if edit == "Age":
                    age_edit = eg.integerbox(str(characters[id]["Age"])
                                        + " is the current age. \n" 
                                        + "What would you like "
                                        + "the new age to be?",
                                        title=constant_title[4])
                    characters[id]["Age"] = age_edit
                    base_detail_edit()

                if edit == "Pronouns":
                    pronoun_edit = eg.choicebox(characters[id]["Pronouns"] 
                                    + " is the current pronouns. \n" 
                                    + "What would you like the new pronouns to be?",
                                    choices=["She/Her","He/Him",
                                            "They/Them","Other"],
                                    title=constant_title[4])
                    characters[id]["Pronouns"] = pronoun_edit
                    base_detail_edit()

                    if pronoun_edit == "Other":
                        pronoun_other = eg.enterbox("Please enter " 
                                        + characters[id]["Name"] + "'s pronouns"
                                        + "\n" 
                                        + "Input it under the format Xx/Yy",
                                        title=constant_title[4])
                        
                    while "/" not in pronoun_other:
                        eg.msgbox("ERROR!",
                                    title="Input Error")
                    pronoun_other = eg.enterbox("Please make sure to enter " 
                                        + characters[id]["Name"]
                                        + "'s pronouns " 
                                        + "under the format Xx/Yy",
                                title=constant_title[4])
                    
                    characters[id]["Pronouns"] = pronoun_other
                    base_detail_edit()

                if edit == "Confirm":
                    confirm = eg.buttonbox("Is " + str(characters[id]) 
                                        + " correct?",
                                        choices=YN_choice,
                                        title=constant_title[3])
                    if confirm == "Yes":
                        main_menu()

                    while confirm == "No":
                        base_detail_edit()
                


            if id in characters:
                eg.msgbox("placeholder")

        base_detail_edit()


def view():
    id = eg.integerbox("What is your characters ID?",
                       title=constant_title[0])
    while id not in characters:
        eg.msgbox("That ID does not exist",
                  title=constant_title[5])
        id = eg.integerbox("What is your characters ID?",
                           title=constant_title[0])
    if id in characters:
        eg.msgbox(characters[id])

        seperate = list(characters[id])
        details = str(seperate).split(",")

        eg.msgbox(details)
        main_menu()

def delete():
    choice_list = []
    for x in characters:
        choice_list.append(x)

    delete = eg.choicebox("What is the id of the character " 
                           + "you want to delete?",
                           choices=choice_list,
                           title="Delete")
    
    delete_confirm = eg.buttonbox("Is " + characters[delete]["Name"] 
                                  + " correct?",
                                  choices=YN_choice,
                                  title=constant_title[3])
    while delete_confirm == "No":
            delete = eg.choicebox("What is the id of the character " 
                                + "you want to delete?",
                                choices=choice_list,
                                title="Delete")
            
            while delete not in characters[delete]:
                delete = eg.choicebox("What is the id of the character " 
                                    + "you want to delete?",
                                    choices=choice_list,
                                    title="Delete")

                delete_confirm = eg.buttonbox("Is " + characters[delete]["Name"] 
                                    + " correct?",
                                    choices=YN_choice,
                                    title=constant_title[3])
    if delete_confirm == "Yes":
        eg.msgbox(characters[delete]["Name"] + " has been deleted",
                  title="Deletion Complete")
        character_num - 1
        characters.pop(delete)

        while character_num == 0:
            eg.msgbox("Since you have no more characters left:" + "\n\n" 
            + "You will be directed back to: Adding a Character",
            title="Character Adder")
            add()

        main_menu()


